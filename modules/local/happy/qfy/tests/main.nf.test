nextflow_process {

    name "Test Process HAPPY_QFY"
    script "../main.nf"
    process "HAPPY_QFY"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "happy"
    tag "happy/qfy"
    tag "happy/happy"

    setup {
        run("HAPPY_HAPPY") {
            script "../../../../nf-core/happy/happy/main.nf"
            process {
                """
                input[0] = [
                        [ id:'test' ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.vcf.gz', checkIfExists:true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.ann.vcf.gz', checkIfExists:true),
                        [],
                        []
                        ]
                input[1] = [
                        [ id:'test2' ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true)
                        ]
                input[2] = [
                        [ id:'test3' ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai', checkIfExists: true)
                        ]
                input[3] = [[],[]]
                input[4] = [[],[]]
                input[5] = [[],[]]
                """
            }
        }
    }

    test("homo_sapiens illumina happy vcf") {

        when {
            process {
                """
                input[0] = HAPPY_HAPPY.out.vcf.join(HAPPY_HAPPY.out.tbi)
                input[1] = [
                        [ id:'test2' ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true)
                        ]
                input[2] = [
                        [ id:'test3' ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai', checkIfExists: true)
                        ]
                input[3] = [[],[]]
                input[4] = [[],[]]
                input[5] = [[],[]]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.vcf.get(0).get(1)).linesGzip.contains("##fileformat=VCFv4.1") },
                { assert snapshot(
                    process.out.summary_csv,
                    process.out.extended_csv,
                    process.out.roc_all_csv,
                    process.out.roc_indel_locations_csv,
                    process.out.roc_snp_locations_csv,
                    process.out.roc_indel_locations_pass_csv,
                    process.out.roc_snp_locations_pass_csv,
                    process.out.findAll { key, val -> key.startsWith('versions') },
                    file(process.out.metrics_json[0][1]).name,
                    file(process.out.tbi[0][1]).name
                ).match() }
            )
        }
    }

    test("homo_sapiens illumina happy vcf false_positives stratification") {

        when {
            process {
                """
                input[0] = HAPPY_HAPPY.out.vcf.join(HAPPY_HAPPY.out.tbi)
                input[1] = [
                        [ id:'test2' ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true)
                        ]
                input[2] = [
                        [ id:'test3' ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai', checkIfExists: true)
                        ]
                input[3] = [
                        [ id:'false_positives' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/multi_intervals.bed', checkIfExists:true)
                        ]
                input[4] = channel.of("multi_intervals\\tmulti_intervals.bed.gz")
                        .collectFile(name:"stratification.tsv", newLine:true)
                        .map { tsv -> [ [ id:'stratification' ], tsv ] }
                input[5] = [
                        [ id:'stratification' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/multi_intervals.bed.gz', checkIfExists:true)
                        ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.extended_csv.get(0).get(1)).text.contains("multi_intervals") },
                { assert snapshot(
                    process.out.summary_csv,
                    process.out.extended_csv,
                    process.out.roc_all_csv,
                    process.out.findAll { key, val -> key.startsWith('versions') },
                    file(process.out.metrics_json[0][1]).name,
                    file(process.out.vcf[0][1]).name,
                    file(process.out.tbi[0][1]).name
                ).match() }
            )
        }
    }

    test("homo_sapiens illumina happy vcf - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = HAPPY_HAPPY.out.vcf.join(HAPPY_HAPPY.out.tbi)
                input[1] = [
                        [ id:'test2' ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true)
                        ]
                input[2] = [
                        [ id:'test3' ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai', checkIfExists: true)
                        ]
                input[3] = [[],[]]
                input[4] = [[],[]]
                input[5] = [[],[]]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
